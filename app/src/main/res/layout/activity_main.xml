<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PKG Manager v2.1.0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnPs3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PlayStation 3 (PS3)"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPs4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PlayStation 4 (PS4)"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPs5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PlayStation 5 (PS5)"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSplitter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Outil Splitter / Merger"
        android:backgroundTint="#FF6200EE"/>

</LinearLayout>
